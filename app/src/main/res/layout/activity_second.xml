<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Содержимое по центру занимает всё место над кнопкой -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSecondTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_second"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Значок результата, scaleType = center (без масштабирования) -->
        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="@dimen/image_second_size"
            android:layout_height="@dimen/image_second_size"
            android:layout_marginTop="@dimen/margin_medium"
            android:contentDescription="@string/desc_image_second"
            android:scaleType="center"
            android:src="@drawable/ic_result" />

        <TextView
            android:id="@+id/tvSecondAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:gravity="center"
            android:textSize="@dimen/text_input" />

        <TextView
            android:id="@+id/tvSecondResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:gravity="center"
            android:textColor="@color/color_result"
            android:textSize="@dimen/text_result"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/button_min_height"
        android:text="@string/btn_back"
        android:textSize="@dimen/text_button" />

</LinearLayout>
