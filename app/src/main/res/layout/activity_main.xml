<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://android.com"
android:id="@+id/mainRoot"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/bg_screen"
android:orientation="vertical"
android:padding="@dimen/screen_padding">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvTitleMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_main"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="match_parent"
        android:layout_height="@dimen/image_height_main"
        android:layout_marginTop="@dimen/element_margin"
        android:contentDescription="@string/desc_main_image"
        android:scaleType="centerInside"
        android:src="@drawable/ic_restaurant" />


    <EditText
        android:id="@+id/etName"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin"
        android:hint="@string/hint_name"
        android:inputType="textPersonName"
        android:textSize="@dimen/text_body" />

    <EditText
        android:id="@+id/etGuests"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin"
        android:hint="@string/hint_guests"
        android:inputType="number"
        android:textSize="@dimen/text_body" />

    <CheckBox
        android:id="@+id/cbWindow"
        android:textColor="@color/text_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin"
        android:text="@string/cb_window"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_margin"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body" />
</LinearLayout>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCalculate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/element_margin"
        android:layout_weight="1"
        android:background="@drawable/selector_button"
        android:onClick="onCalculateClick"
        android:text="@string/btn_calculate"
        android:textColor="@color/text_on_button"
        android:textSize="@dimen/text_body" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/selector_button"
        android:onClick="onNextClick"
        android:text="@string/btn_next"
        android:textColor="@color/text_on_button"
        android:textSize="@dimen/text_body" />
</LinearLayout>

</LinearLayout>