<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="@dimen/constraint_fill"
        android:layout_height="@dimen/constraint_fill"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/content_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="@dimen/page_padding">

            <TextView
                android:id="@+id/tv_form_title"
                style="@style/TaskScreenTitle"
                android:text="@string/app_name" />

            <FrameLayout
                android:id="@+id/frame_discount_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:layout_marginTop="@dimen/field_gap"
                android:background="@drawable/bg_hero"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/iv_discount_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/discount_image_description"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_discount" />

                <TextView
                android:id="@+id/tv_discount_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="@dimen/field_gap"
                    android:background="@drawable/bg_help_badge"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="@dimen/field_gap"
                    android:paddingVertical="@dimen/label_gap"
                    android:text="@string/discount_badge"
                    android:textColor="@color/hero_ink"
                    android:textSize="@dimen/badge_size"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_price_label"
                style="@style/TaskLabel"
                android:text="@string/price_label"
                android:layout_marginTop="@dimen/section_gap"
                android:labelFor="@+id/et_price" />

            <EditText
                android:id="@+id/et_price"
                style="@style/TaskInput"
                android:hint="@string/price_hint"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:digits="0123456789,."
                android:maxLength="13"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_discount_label"
                style="@style/TaskLabel"
                android:text="@string/discount_label"
                android:layout_marginTop="@dimen/field_gap"
                android:labelFor="@+id/et_discount" />

            <EditText
                android:id="@+id/et_discount"
                style="@style/TaskInput"
                android:hint="@string/discount_hint"
                android:inputType="numberDecimal|numberSigned"
                android:digits="0123456789,.-"
                android:maxLength="13"
                android:maxLines="1" />

            <LinearLayout
                android:id="@+id/row_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_gap"
                android:orientation="horizontal">

                <android.widget.Button
                    android:id="@+id/btn_calculate"
                    style="@style/TaskButton"
                    android:layout_width="@dimen/constraint_fill"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/field_gap"
                    android:text="@string/calculate" />

                <android.widget.Button
                    android:id="@+id/btn_next"
                    style="@style/TaskButton"
                    android:layout_width="@dimen/constraint_fill"
                    android:layout_weight="1"
                    android:text="@string/next" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_result"
                style="@style/TaskLabel"
                android:layout_marginTop="@dimen/section_gap"
                android:accessibilityLiveRegion="polite"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
