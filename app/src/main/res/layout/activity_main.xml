<?xml version="1.0" encoding="utf-8"?>
<!-- Корневой вертикальный LinearLayout: форма (weight=1) + строка кнопок внизу -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Форма: layout_weight=1 забирает всё место, не занятое кнопками -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_main"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Иллюстрация растягивается по свободной высоте (weight=1), fitCenter -->
        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_weight="1"
            android:contentDescription="@string/desc_image_main"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_currency" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:hint="@string/hint_amount"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="@dimen/field_min_height"
            android:textSize="@dimen/text_input" />

        <EditText
            android:id="@+id/etRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:hint="@string/hint_rate"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="@dimen/field_min_height"
            android:textSize="@dimen/text_input" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:gravity="center"
            android:textColor="@color/color_result"
            android:textSize="@dimen/text_result"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Кнопки внизу делят ширину поровну: width=0dp и одинаковый weight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCalc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="@dimen/button_min_height"
            android:text="@string/btn_calc"
            android:textSize="@dimen/text_button" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_weight="1"
            android:minHeight="@dimen/button_min_height"
            android:text="@string/btn_next"
            android:textSize="@dimen/text_button" />
    </LinearLayout>

</LinearLayout>
